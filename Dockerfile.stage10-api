FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-stage10-api.txt ./
RUN python -m pip install --no-cache-dir -r requirements-stage10-api.txt

# Preserve the namespace-package paths used by the Stage 10 API imports.
COPY src/stage9/__init__.py src/stage9/resnet18_inference.py ./src/stage9/
COPY src/stage10/__init__.py src/stage10/api.py src/stage10/triton_classifier.py ./src/stage10/

# Run:ai uses this numeric UID; torch imports require it to resolve via getpwuid().
RUN printf '%s\n' 'stage10api:x:65532:65532:Stage 10 API:/tmp:/usr/sbin/nologin' >> /etc/passwd \
    && printf '%s\n' 'stage10api:x:65532:' >> /etc/group

USER 65532:65532
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "src.stage10.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
